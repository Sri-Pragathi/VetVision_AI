# Environment mode: development, testing, or production
FLASK_ENV=development
FLASK_DEBUG=1

# Production Security:
# In production (FLASK_ENV=production), both SECRET_KEY and JWT_SECRET_KEY MUST be set
# to unique, randomly generated strings (min 32 characters). The app refuses to boot if default placeholders are used.
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-to-a-secure-random-string

# Server configuration
PORT=5000
HOST=0.0.0.0

# Database Configuration:
# - Production requires PostgreSQL (e.g., Neon, Supabase, Render PostgreSQL).
#   Most managed cloud databases require '?sslmode=require'.
# - SQLite fallback is strictly for local single-process development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vetvision_db?sslmode=require
# For local SQLite development without PostgreSQL:
# DATABASE_URL=sqlite:///vetvision_dev.db

# JWT Token Expiration
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# CORS Configuration:
# - In development: accepts '*' or comma-separated origins.
# - In production: MUST be an explicit comma-separated list of allowed frontend domains.
#   Wildcard '*' is forbidden and rejected in production mode.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Local Development Demo Account (Optional)
# DEV_DEMO_PASSWORD=Password123!
